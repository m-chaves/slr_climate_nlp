SEMANTIC_SCHOLAR_API_KEY=your_key_here_without_quotes
SCOPUS_API_KEY=your_key_here_without_quotes

# Read-only key from https://www.zotero.org/settings/keys
# ZOTERO_LIBRARY_ID is the numeric userID shown on that page, not your username.
ZOTERO_API_KEY=your_key_here_without_quotes
ZOTERO_LIBRARY_ID=your_numeric_user_id